#!/usr/bin/env python3
"""Run Cortex without installing a Python package or requiring a particular AI tool."""
import runpy
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / 'installer'))
runpy.run_path(str(root / 'installer/main.py'), run_name='__main__')
