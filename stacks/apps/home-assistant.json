{
  "services": {
    "home-assistant": {
      "image": "${HOME_ASSISTANT_IMAGE:?set immutable image reference with sha256 digest}",
      "container_name": "cortex-home-assistant",
      "restart": "unless-stopped",
      "networks": [
        "cortex-private"
      ],
      "volumes": [
        "@DATA_ROOT@/home-assistant:/config",
        "/etc/localtime:/etc/localtime:ro"
      ],
      "ports": [
        "127.0.0.1:8123:8123"
      ],
      "env_file": [
        "@SECRETS_DIR@/home-assistant.env"
      ],
      "stop_grace_period": "60s"
    }
  },
  "networks": {
    "cortex-private": {
      "external": true
    }
  }
}
