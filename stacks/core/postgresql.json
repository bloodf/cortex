{
  "services": {
    "postgresql": {
      "image": "postgres:17.6-bookworm@sha256:f3bd19c606e442c3d7bdfa8002e03fe260a1023351e0ea4598032022b68dd6e3",
      "container_name": "cortex-postgresql",
      "restart": "unless-stopped",
      "env_file": [
        "@SECRETS_DIR@/postgresql.env"
      ],
      "ports": [
        "127.0.0.1:5432:5432"
      ],
      "volumes": [
        "@DATA_ROOT@/postgresql:/var/lib/postgresql/data"
      ],
      "networks": [
        "cortex-private"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30
      }
    }
  },
  "networks": {
    "cortex-private": {
      "external": true
    }
  }
}
