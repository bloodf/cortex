{
  "services": {
    "mongodb": {
      "image": "mongo:8.0.13@sha256:cf340b1e5283843c63eb12999922f20c463ae31285f746d30f05dcc21cd1d47c",
      "container_name": "cortex-mongodb",
      "restart": "unless-stopped",
      "env_file": [
        "@SECRETS_DIR@/mongodb.env"
      ],
      "ports": [
        "127.0.0.1:27017:27017"
      ],
      "volumes": [
        "@DATA_ROOT@/mongodb:/data/db"
      ],
      "networks": [
        "cortex-private"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "mongosh --quiet --username \"$${MONGO_INITDB_ROOT_USERNAME}\" --password \"$${MONGO_INITDB_ROOT_PASSWORD}\" --authenticationDatabase admin --eval \"quit(db.adminCommand({ping:1}).ok ? 0 : 1)\""
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30
      }
    }
  },
  "networks": {
    "cortex-private": {
      "external": true
    }
  }
}
