{
  "global": {
    "scrape_interval": "30s",
    "scrape_timeout": "10s"
  },
  "scrape_configs": [
    {
      "job_name": "prometheus",
      "static_configs": [
        {
          "targets": [
            "localhost:9090"
          ]
        }
      ]
    },
    {
      "job_name": "selected-exporters",
      "file_sd_configs": [
        {
          "files": [
            "/etc/prometheus/targets/selected.json"
          ],
          "refresh_interval": "30s"
        }
      ]
    }
  ]
}
